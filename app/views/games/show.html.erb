<% if ModernArtPractice.owner?(request.host, current_user) %>
  <p class="panel"><%= link_to "Modern Art practice tables", modern_art_practice_tables_path %></p>
<% end %>

<div id="games-show"></div>

<script id="games-show-data" type="application/json">
  <%= raw json_escape({
    game: @rep_game,
    token: form_authenticity_token,
    paths: Representers::Paths.()
  }.to_json) %>
</script>

<%= vite_javascript_tag "game" %>
