<main id="game-directory" class="directory-content replay-content" data-art-role="default" tabindex="-1">
  <p><%= link_to ProductionReplay.enabled? ? "My replays" : "Live table",
    ProductionReplay.enabled? ? replays_path : game_session_path(@replay_session.uid) %></p>
  <h2>Modern Art replay</h2>
  <div id="session-replay"></div>
  <script id="session-replay-data" type="application/json"><%= raw json_escape({
    initial: @replay, replayPath: session_replay_path(@replay_session.uid)
  }.to_json) %></script>
  <%= vite_javascript_tag "session_replay" %>
</main>
