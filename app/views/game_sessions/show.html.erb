<%= render "shared/modern_art_rules_drawer", trigger: true if @game_session.game.key == "modern_art" && !@digital_board %>
<% if @game_session.can_replay?(current_user) %>
  <% if !@digital_table || @digital_board %><p><%= link_to "Replay history", session_replay_path(@game_session.uid) %></p><% end %>
<% end %>
<% if ExperimentalAccess.enabled? && @digital_table&.owner_id == current_user.id %>
  <details class="panel" <%= "open" unless @digital_board %>>
    <summary>Manage staging seats</summary>
    <% if @game_session.joinable? %>
      <%= form_with url: session_dummies_path(@game_session.uid), local: true do |f| %>
        <%= f.label :seat_name, "Guest display name" %>
        <%= f.text_field :seat_name, maxlength: 60 %>
        <%= f.submit "Add human seat" %>
      <% end %>
    <% end %>
    <% @game_session.all_players.joins(:dummy_access).includes(:user).each do |seat| %>
      <p><%= seat.user.name %></p>
      <%= button_to "Issue new code", rotate_session_dummy_path(@game_session.uid, seat.id) %>
      <%= button_to "Revoke access", session_dummy_path(@game_session.uid, seat.id), method: :delete %>
    <% end %>
  </details>
<% end %>
<% if @digital_board %>
  <%= render "shared/modern_art_digital_table", board: @digital_board, uid: @game_session.uid,
    endpoint: game_session_path(@game_session.uid), lobby_url: root_path, channel: "GameSessionChannel" %>
<% elsif @digital_table %>
  <section class="panel">
    <h2>Waiting for human players</h2>
    <p><%= @game_session.players.count %> seats joined. Start with three to five. Each guest uses a private seat grant.</p>
    <% if @digital_table.owner_id == current_user.id && @game_session.playable? %>
      <%= button_to "Start human game", game_session_path(@game_session.uid), method: :patch, params: { command: "start" } %>
    <% end %>
    <p><%= link_to "Refresh table", game_session_path(@game_session.uid) %></p>
  </section>
<% else %>
<div id="game-sessions-show"></div>

<script id="game-sessions-show-data" type="application/json">
  <%= raw json_escape({
    session: @rep_session,
    token: form_authenticity_token,
    currentUser: Representers::User.(current_user),
    paths: Representers::Paths.()
  }.to_json) %>
</script>

<%= vite_javascript_tag "game_session" %>

<% end %>
