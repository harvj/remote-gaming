<% if @game_session.can_replay?(current_user) %>
  <p><%= link_to "Replay history", session_replay_path(@game_session.uid) %></p>
<% end %>
<% if ExperimentalAccess.enabled? && @game_session.experimental? %>
  <section class="panel">
    <h2><%= @game_session.parent_session_id? ? "Private experimental branch" : "Private experiment" %></h2>
    <% if @game_session.parent_session_id? %>
      <p>Forked at frame <%= @game_session.fork_frame.sequence %> · Rules v<%= @game_session.branch_rules_version %></p>
      <% if @game_session.parent_session.can_replay?(current_user) %>
        <p><%= link_to "Original timeline", session_replay_path(@game_session.parent_session.uid, frame: @game_session.fork_frame.sequence) %></p>
      <% end %>
    <% end %>
    <% if @game_session.experiment_owner_id == current_user.id %>
      <% if @game_session.joinable? %>
        <%= button_to "Add dummy player", session_dummies_path(@game_session.uid) %>
      <% end %>
      <% @game_session.all_players.joins(:dummy_access).includes(:user).each do |seat| %>
        <p><%= seat.user.name %></p>
        <%= button_to "Issue new code", rotate_session_dummy_path(@game_session.uid, seat.id) %>
        <%= button_to "Revoke access", session_dummy_path(@game_session.uid, seat.id), method: :delete %>
      <% end %>
    <% end %>
  </section>
<% end %>
<div id="game-sessions-show"></div>

<script id="game-sessions-show-data" type="application/json">
  <%= raw json_escape({
    session: @rep_session,
    token: form_authenticity_token,
    currentUser: Representers::User.(current_user),
    paths: Representers::Paths.()
  }.to_json) %>
</script>

<%= vite_javascript_tag "game_session" %>
