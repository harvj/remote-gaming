<nav class="directory-nav" aria-label="Account navigation">
  <% if directory_signed_in? %>
    <details class="directory-apps">
      <summary><span class="shell-session-dot" aria-hidden="true"></span><span class="shell-username"><%= session[:oidc_username].presence || "Signed in" %></span><span class="shell-chevron" aria-hidden="true">⌄</span></summary>
      <ul class="directory-account-controls">
        <% if CanonicalAuth.enabled? && session[:oidc_login] %>
          <li data-shell-applications="<%= shell_applications_path %>" hidden>
            <section aria-label="Applications"><strong>Applications</strong><ul></ul></section>
          </li>
        <% end %>
        <% if CanonicalAuth.enabled? && (account_url = CanonicalAuth.account_settings_url) %>
          <li><%= link_to "Account Settings", account_url %></li>
        <% end %>
        <% if (logout = respond_to?(:canonical_logout_path) ? canonical_logout_path : (logout_path if respond_to?(:logout_path))) %>
          <li><%= button_to "Log Out", logout, method: :delete %></li>
        <% end %>
      </ul>
    </details>
  <% else %>
    <%= link_to "Log In", login_path, class: "directory-login" %>
  <% end %>
</nav>
