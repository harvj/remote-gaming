<nav class="directory-nav" aria-label="Account navigation">
  <% if directory_signed_in? %>
    <details class="directory-apps">
      <summary><%= session[:oidc_login] && session[:oidc_username].presence || "Signed in" %> <span aria-hidden="true">⌄</span></summary>
      <ul>
        <li><%= link_to "Account Settings", "https://auth.harvj.com/" %></li>
        <% if respond_to?(:logout_path) %><li><%= button_to "Log Out", logout_path, method: :delete %></li><% end %>
      </ul>
    </details>
  <% else %>
    <%= link_to "Log In", login_path, class: "directory-login" %>
  <% end %>
</nav>
