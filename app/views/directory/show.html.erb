<main id="game-directory" class="directory-content" data-art-role="default" aria-label="<%= @game_page ? @title : "Games" %>" tabindex="-1">
  <% if @game_page %><p><a href="<%= @directory_url || "https://radioactivita.com/" %>">Remote Gaming directory</a></p><% end %>
  <% if @game_page %><h1><%= @title %></h1><% end %>
  <ul class="<%= "directory-cards" unless @game_page %>" role="list">
    <% @games.each do |game| %>
      <li>
        <% unless @game_page %><h2><%= game.fetch(:title) %></h2><% end %>
        <p><%= game.fetch(:description) %></p>
        <% if game.fetch(:available) && !@game_page %>
          <p class="directory-status">Available · <%= link_to "Open #{game.fetch(:title)}", game.fetch(:destination) %></p>
        <% elsif !game.fetch(:available) %>
          <p class="directory-status">Not yet available</p>
        <% end %>
      </li>
    <% end %>
  </ul>
</main>
