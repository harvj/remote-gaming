<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @title %></title>
    <%= stylesheet_link_tag "directory" %>
    <%= vite_client_tag %>
    <%= yield :head %>
    <%= render "shared/site_art_head" %>
  </head>
  <body class="directory-site">
    <div id="site-art-background" aria-hidden="true"></div>
    <a class="directory-skip" href="#game-directory">Skip to content</a>
    <header class="directory-header" data-art-role="top">
      <%= content_tag(@game_page ? :div : :h1, class: "directory-brand") do %>
        <%= link_to (@directory_url || (@game_page ? "https://radioactivita.com/" : "/")), class: "directory-wordmark" do %>
          remote-gaming<span>.</span>
        <% end %>
      <% end %>
      <%= render "directory/navigation" %>
    </header>
    <%= yield %>
    <footer class="directory-footer" data-art-role="bottom">
      <span>© <%= Date.current.year %> Jim Harvey</span>
      <span><span aria-hidden="true">·</span> <%= Rails.configuration.x.directory_release_label %></span>
    </footer>
  </body>
</html>
