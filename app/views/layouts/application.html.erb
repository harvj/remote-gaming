<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Remote Gaming" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Remote Gaming">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <% unless ModernArtStaging.enabled? %><link rel="apple-touch-icon" href="/icon.png"><% end %>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%= vite_client_tag %>
    <%= stylesheet_link_tag :app %>
    <script src="https://kit.fontawesome.com/c8fac941ce.js" crossorigin="anonymous"></script>

    <%= render "shared/site_art_head" %>
  </head>

  <body>
    <div id="site-art-background" aria-hidden="true"></div>
    <header class="navbar">
      <div id="navbar-app"></div>

      <script id="navbar-data" type="application/json">
        <%= raw json_escape({
          currentUser: current_user ? {
            name: current_user.username || current_user.name,
            profilePath: current_user.dummy? ? nil : user_path(current_user),
            logoutPath: current_user.dummy? ? dummy_logout_path : logout_path
          } : nil,
          currentGame: @game ? {
            uri: game_path(@game.key),
            name: @game.name
          } : nil,
          loginPath: login_path,
          csrfToken: form_authenticity_token
        }.to_json) %>
      </script>

      <%= vite_javascript_tag "navbar" %>
    </header>

    <main class="page">
      <% if ModernArtStaging.enabled? %>
        <p class="panel ghost"><strong>Private staging</strong> · Use approved accounts and test data.</p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
