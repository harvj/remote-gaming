<% if @cursor %>
  <nav class="panel" aria-label="Practice replay actions">
    <%= link_to "Previous action", modern_art_practice_table_path(@table.uid, frame: @cursor - 1) if @cursor.positive? %>
    <span>Action <%= @cursor %> of <%= @table.commands.length %></span>
    <%= link_to "Next action", modern_art_practice_table_path(@table.uid, frame: @cursor + 1) if @cursor < @table.commands.length %>
  </nav>
<% elsif @table.commands.any? %>
  <p><%= link_to "Replay practice game", modern_art_practice_table_path(@table.uid, frame: @table.commands.length) %></p>
<% end %>
<%= render "shared/modern_art_digital_table", board: @board, uid: @table.uid,
  endpoint: modern_art_practice_table_path(@table.uid), lobby_url: (@cursor ? modern_art_practice_table_path(@table.uid) : modern_art_practice_tables_path),
  channel: "ModernArtPracticeChannel", replay: @cursor.present? %>
<% unless @cursor %>
<details class="panel">
  <summary>Remove this disposable table</summary>
  <%= button_to "Delete practice table", modern_art_practice_table_path(@table.uid), method: :delete %>
</details>

<% end %>
