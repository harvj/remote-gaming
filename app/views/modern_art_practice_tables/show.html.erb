<div id="practice-table"></div>
<script id="practice-table-data" type="application/json">
  <%= raw json_escape({
    board: @board, uid: @table.uid, endpoint: modern_art_practice_table_path(@table.uid),
    rulesUrl: rules_modern_art_practice_tables_path, lobbyUrl: modern_art_practice_tables_path,
    token: form_authenticity_token
  }.to_json) %>
</script>
<%= vite_javascript_tag "modern_art_practice" %>
<details class="panel">
  <summary>Remove this disposable table</summary>
  <%= button_to "Delete practice table", modern_art_practice_table_path(@table.uid), method: :delete %>
</details>
