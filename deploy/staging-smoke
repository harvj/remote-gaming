#!/usr/bin/env bash
set -euo pipefail
directory=staging.radioactivita.com
modern=modern-art.$directory
pandemic=pandemic.$directory

request() {
  local host=$1 path=$2
  shift 2
  if [[ -n ${PUMA_URL:-} ]]; then
    curl -sS --max-time 10 -H "Host: $host" "$@" "$PUMA_URL$path"
  elif [[ -n ${STAGING_NETRC:-} ]]; then
    curl -sS --max-time 10 --netrc-file "$STAGING_NETRC" "$@" "https://$host$path"
  else
    curl -sS --max-time 10 "$@" "https://$host$path"
  fi
}

status() { request "$@" -o /dev/null -w '%{http_code}'; }
location() { request "$@" -o /dev/null -w '%{redirect_url}'; }

if [[ -n ${PUMA_URL:-} ]]; then
  [[ $(status radioactivita.com /) == 403 ]]
elif [[ -n ${STAGING_NETRC:-} ]]; then
  for host in "$directory" "$modern" "$pandemic"; do
    [[ $(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' "https://$host/") == 401 ]]
  done
fi

for host in "$directory" "$modern" "$pandemic"; do
  request "$host" /up -fo /dev/null
  request "$host" /ready -fo /dev/null
done

for host in "$directory" "$pandemic"; do
  [[ $(status "$host" /login) == 404 ]]
  [[ $(status "$host" /s/staging-probe -H 'Accept: application/json') == 404 ]]
done
[[ $(status "$modern" /) == 302 ]]
[[ $(status "$modern" /pandemic) == 404 ]]
[[ $(status "$modern" /s/staging-probe -H 'Accept: application/json') == 401 ]]

if [[ $(status "$modern" /login) == 302 ]]; then
  [[ $(location "$modern" /login) == https://auth.harvj.com/authorize\?* ]]
  [[ $(location "$directory" /) == "https://$modern/staging/directory" ]]
  [[ $(location "$pandemic" /) == "https://$modern/staging/pandemic" ]]
  for path in /staging/directory /staging/pandemic; do
    [[ $(status "$modern" "$path") == 302 ]]
    [[ $(location "$modern" "$path") == */login ]]
    [[ $(status "$modern" "$path" -H 'Accept: application/json') == 401 ]]
  done
  [[ $(status "$modern" /auth/callback) == 401 ]]
  [[ $(status "$modern" /login -X POST) != 200 ]]
  page=$(request "$modern" /dummy/login -f)
  grep -q 'dummy_credential' <<< "$page"
else
  # The legacy branch remains available while the candidate is behind Basic Auth.
  [[ -n ${PUMA_URL:-} || -n ${STAGING_NETRC:-} ]]
  page=$(request "$directory" / -f)
  grep -q 'Remote Gaming staging' <<< "$page"
  grep -q "https://$modern/" <<< "$page"
  page=$(request "$pandemic" / -f)
  grep -q 'Not yet available' <<< "$page"
  page=$(request "$modern" /login -f)
  grep -q 'Private staging' <<< "$page"
  asset=$(sed -nE 's@.*src="(/vite/[^"]+\.js)".*@\1@p' <<< "$page" | head -n1)
  [[ -n $asset ]]
  request "$modern" "$asset" -fo /dev/null
fi

printf '%s\n' 'Private staging HTTP smoke checks passed for all three hostnames'
