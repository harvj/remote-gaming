RAILS_ENV=production
BIND_HOST=127.0.0.1
PORT=3012
RAILS_MAX_THREADS=3
PATH=/opt/remote-gaming/ruby/bin:/usr/bin:/bin
BUNDLE_FROZEN=true
BUNDLE_WITHOUT=development:test
DATABASE_URL=postgresql://remote_gaming:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/remote_gaming_production
SECRET_KEY_BASE=REPLACE_WITH_HEX_SECRET
GAME_DIRECTORY_PATH=/etc/remote-gaming/game_directory.yml
