RAILS_ENV=production
BIND_HOST=127.0.0.1
PORT=3013
RAILS_MAX_THREADS=3
PATH=/opt/remote-gaming/ruby/bin:/usr/bin:/bin
BUNDLE_FROZEN=true
BUNDLE_WITHOUT=development:test
DATABASE_URL=postgresql://remote_gaming_staging:REPLACE_WITH_HEX_PASSWORD@127.0.0.1:5432/remote_gaming_staging
SECRET_KEY_BASE=REPLACE_WITH_HEX_SECRET
REMOTE_GAMING_PRIVATE_STAGING=1

# Optional owner-only practice sessions on the Modern Art staging host.
REMOTE_GAMING_MODERN_ART_PRACTICE=0
