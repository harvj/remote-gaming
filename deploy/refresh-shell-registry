#!/usr/bin/env python3
"""Refresh using the installed Infrastructure verifier and pinned public keys."""

from pathlib import Path
import subprocess
import sys

INFRASTRUCTURE = Path("/usr/local/lib/application-shell")
sys.path.insert(0, str(INFRASTRUCTURE / "lib"))

from application_shell_gate import GateError, HttpsPublisher, deadline, decode
from application_shell_registry_cache import refresh
from application_shell_renewal import ORIGIN, installed_pins


def fetch_compatible(path):
    raw = publisher(path)
    if path.endswith("/manifest.json") and decode(raw).get("behavior_baseline") != "shell-v1":
        raise GateError("Unsupported Application Shell behavior baseline")
    return raw


publisher = HttpsPublisher(ORIGIN)

if __name__ == "__main__":
    cache = Path(sys.argv[1])
    try:
        with deadline(45):
            snapshot = refresh(cache, fetch_compatible, installed_pins(INFRASTRUCTURE / "deploy"))
        cache.chmod(0o644)
    except (GateError, OSError, ValueError, TypeError, KeyError, AttributeError, subprocess.SubprocessError) as error:
        sys.exit(f"Shell registry refresh failed: {error}")
    print(f"Verified Shell registry {snapshot['specification_version']} sequence {snapshot['sequence']}")
